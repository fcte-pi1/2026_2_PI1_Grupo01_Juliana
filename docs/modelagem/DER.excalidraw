      "text": "PK falha_id        BIGSERIAL\nFK tentativa_id   UUID  UNIQUE\n   motivo           VARCHAR\n                       (collision|stuck  |out_of_track|\n                       time_exceeded | falha_componente\n                       low_battery | health_check_failed\n                       link_lost | encerrado_operador)\n   origem            VARCHAR (automatica\n                                  encerrado_operador)\n   x, y               INT\n   componente     VARCHAR NULL\n   observacao      VARCHAR(100)\n   momento_falha TIMESTAMPTZ",
